{
  "name": "linoy-designs-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "prisma generate && tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "test:routes": "node scripts/test-routes.mjs",
    "test:postgres": "node scripts/prepare-test-database.mjs && tsx --test tests/postgres-security.test.ts",
    "typecheck": "prisma generate && tsc -b && tsc -p tsconfig.server.json",
    "test": "npm run build && npm run test:routes && npm run test:postgres",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "api:start": "node dist/api/index.mjs",
    "start": "prisma migrate deploy && node dist/api/index.mjs",
    "api:dev": "tsx watch server/index.ts",
    "cap:sync": "cap sync",
    "cap:android": "cap add android",
    "cap:ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.4",
    "leaflet": "^1.9.4",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
