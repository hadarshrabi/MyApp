{
  "name": "linoy-designs-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:routes": "node scripts/test-routes.mjs",
    "test:api": "node --test tests/api-permissions.test.mjs",
    "test": "npm run build && npm run test:routes && npm run test:api",
    "cap:sync": "cap sync",
    "cap:android": "cap add android",
    "cap:ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.4.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
