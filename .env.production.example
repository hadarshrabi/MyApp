# Copy to .env.production outside Git and replace every CHANGE_ME value.
# Never commit the resulting file.
COMPOSE_PROJECT_NAME=myapp-production

# Immutable application artifacts that passed CI and Trivy.
APP_IMAGE=ghcr.io/hadarshrabi/myapp-app@sha256:1b1ad3c95b7dfb4bc07c6f15d870bb761c44e1dadc4140983b9b054f138815d6
MIGRATION_IMAGE=ghcr.io/hadarshrabi/myapp-migration@sha256:762a145c41e63bd5ff52c860fe719383ab99581bcc320c99482f383e71a167ac

# Multi-platform OCI indexes verified for linux/amd64 and linux/arm64.
POSTGRES_IMAGE=postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

POSTGRES_DB=linoy_designs
POSTGRES_USER=linoy_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=linoy-designs-api
JWT_AUDIENCE=linoy-designs-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SHUTDOWN_TIMEOUT_MS=10000

# Local validation values. For a real server use the exact public HTTPS origin.
APP_DOMAIN=localhost
APP_ORIGIN=https://localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=1.0
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.50
MIGRATION_MEMORY_LIMIT=512m
MIGRATION_CPU_LIMIT=1.0

# Used only by rollback.sh and must also be an immutable digest reference.
ROLLBACK_APP_IMAGE=ghcr.io/hadarshrabi/myapp-app@sha256:1b1ad3c95b7dfb4bc07c6f15d870bb761c44e1dadc4140983b9b054f138815d6
