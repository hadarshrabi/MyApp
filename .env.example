# Copy this file to .env for local Docker development. Never commit .env.
# Docker Compose constructs DATABASE_URL internally using the values below.
POSTGRES_DB="linoy_designs"
POSTGRES_USER="linoy_app"
POSTGRES_PASSWORD="replace-with-a-strong-local-password"
POSTGRES_PORT="5432"
APP_PORT="3001"
SHUTDOWN_TIMEOUT_MS="10000"

# Used only when running Node/Prisma directly on the host.
DATABASE_URL="postgresql://linoy_app:replace-with-a-strong-local-password@localhost:5432/linoy_designs?schema=public"

JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ISSUER="linoy-designs-api"
JWT_AUDIENCE="linoy-designs-app"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

# Host-based development uses Vite on 5173. Docker Compose overrides this to
# http://localhost:${APP_PORT}, because Express serves React in the container.
APP_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Required only when running the seed command.
SEED_ADMIN_PASSWORD="set-a-strong-local-only-password"
SEED_EMPLOYEE_PASSWORD="set-a-different-strong-local-only-password"
SEED_STATION_NAME="עמדת פיתוח"
SEED_STATION_ADDRESS=""
SEED_STATION_DESCRIPTION="מיקום פיתוח בלבד"
SEED_STATION_LATITUDE="32.0743"
SEED_STATION_LONGITUDE="34.7925"
